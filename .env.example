# AgentTrust environment template.
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file must never contain a real
# secret (quality redline 3).

# ----------------------------------------------------------------------------- chain
# Monad Testnet. Testnet is 10143; mainnet is 143. Do not swap these.
CHAIN_ID=10143
RPC_URL_10143=https://testnet-rpc.monad.xyz
EXPLORER_URL_10143=https://testnet.monadscan.com

# Filled in by `npm run deploy:testnet` in contracts/. Empty means "not deployed yet".
AGENTTRUST_REGISTRY_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=

# Deployer / requester key. Testnet only. Never use a mainnet key here.
DEPLOYER_PRIVATE_KEY=

# One on-chain address per cohort member, in validators/cohort.yaml order.
# Required only for `--chain live`. Example:
#   AGENTTRUST_COHORT_ADDRESSES=0xaaa...,0xbbb...,0xccc...,0xddd...,0xeee...
AGENTTRUST_COHORT_ADDRESSES=
AGENTTRUST_VALIDATOR_ADDRESS_1=
AGENTTRUST_VALIDATOR_ADDRESS_2=
AGENTTRUST_VALIDATOR_ADDRESS_3=
AGENTTRUST_VALIDATOR_ADDRESS_4=
AGENTTRUST_VALIDATOR_ADDRESS_5=

# ----------------------------------------------------------------------------- models
# First heterogeneous source: Qwen via Alibaba Cloud Model Studio (DashScope).
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3-max
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_INTL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Second heterogeneous source: Kimi via the Moonshot platform.
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.6
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_INTL_BASE_URL=https://api.moonshot.ai/v1

# Optional third model family. Enables strict heterogeneity (every family distinct).
# See `optional_third_family` in validators/cohort.yaml.
THIRD_FAMILY_MODEL=
THIRD_FAMILY_BASE_URL=

# ----------------------------------------------------------------------------- mechanism
# Frozen spec values. Change only with a re-calibration (divergence/calibrate.py).
THETA_LOW=1.5
THETA_HIGH=3.0
MAX_ROUNDS=3
MIN_USABLE_VALIDATORS=2
TERMINAL_METRIC=l2
D_BASE_DEFAULT=0.5

# `auto` | `live` | `offline`
COHORT_MODE=auto
# `dry-run` | `live`
CHAIN_MODE=dry-run

ARTIFACTS_DIR=
LOG_LEVEL=INFO
