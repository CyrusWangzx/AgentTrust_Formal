# ---------------------------------------------------------------------------------------
# Secrets. NEVER commit these.
# ---------------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------------------
# Node / Hardhat
# ---------------------------------------------------------------------------------------
node_modules/
contracts/cache/
contracts/artifacts/
contracts/typechain-types/

# ---------------------------------------------------------------------------------------
# Generated run artifacts. `artifacts/ledger.jsonl` is produced by the demo; it is a real
# record of a local run, not source, so it stays out of the repository.
# ---------------------------------------------------------------------------------------
artifacts/
.tmp/
npm-cache/
*.log

# The panel feed is regenerated by `scripts/demo/run_demo.py` and by the deploy script, but
# `frontend/data/deployment.json` carries a real deployed address and IS committed once it
# exists - see DEPLOYMENT.md.
!frontend/data/deployment.json

# ---------------------------------------------------------------------------------------
# WorkBuddy local project data: agent memory notes, session artifacts. Local working state,
# not part of the deliverable - the same reasoning as `artifacts/` above.
# ---------------------------------------------------------------------------------------
.workbuddy/
